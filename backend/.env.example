# Copy to .env and adjust as needed. All values below are the defaults used
# when a variable is unset (see app/core/config.py).

# SQLAlchemy database URL. SQLite file path is relative to the backend/ working
# directory inside the container; the `data` directory is a mounted volume so
# the database persists across container restarts.
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# When true: skip the live scheduler/IRD sync entirely and just ensure the
# deterministic demo fixtures (scripts/seed_demo.py) are loaded on startup.
# Useful for UI development/E2E testing without depending on IRD uptime.
DEMO_MODE=false

# Public IRD winners API base (no trailing slash, no /winners suffix).
IRD_API_BASE_URL=https://prize.ird.gov.np/api/v1/public
IRD_PAGE_LIMIT=100
IRD_REQUEST_TIMEOUT_SECONDS=15
IRD_MAX_RETRIES=3

# Daily sync scheduler.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kathmandu

LOG_LEVEL=INFO
