# Root-level example env for docker-compose. Copy to .env and adjust as needed.
# Set to "true" to boot the backend in demo mode (deterministic seeded fixtures,
# no live IRD sync, no scheduler) -- useful for trying the UI without waiting
# on a real government sync cycle.
DEMO_MODE=false

# Signing secret for login sessions (JWT). The built-in default is clearly insecure and
# only exists so `docker compose up` works out of the box for local/demo use -- the backend
# logs a startup warning if it's still in use. Set a real random value before any shared/
# public deployment, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=insecure-dev-secret-change-me-before-any-real-deployment
